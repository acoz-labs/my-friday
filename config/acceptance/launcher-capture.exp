#!/usr/bin/expect -f
if {$argc != 4} { exit 64 }
set timeout -1
set transcript [lindex $argv 0]
set marker [lindex $argv 1]
set launcher [lindex $argv 2]
set prompt [lindex $argv 3]
if {[file pathtype $transcript] ne "absolute"} { exit 64 }
if {$marker eq ""} { exit 64 }
if {[string first $marker $prompt] >= 0} { exit 65 }
if {[catch {set transcript_fd [open $transcript {WRONLY CREAT EXCL} 0600]}]} { exit 73 }
fconfigure $transcript_fd -translation binary -encoding binary -buffering none
set stty_init "rows 30 columns 120"
log_user 0
log_file -a -leaveopen $transcript_fd
spawn -noecho {*}[list $launcher $prompt]

proc child_eof {} {
  global transcript_fd
  set status [wait]
  log_file
  close $transcript_fd
  set child_status [lindex $status 3]
  if {$child_status != 0} { exit $child_status }
  exit 1
}
expect {
  -exact $marker {
    log_file
    puts -nonewline $transcript_fd "\r\n$marker\r\n"
    flush $transcript_fd
    close
    catch wait
    close $transcript_fd
    exit 0
  }
  eof { child_eof }
}
