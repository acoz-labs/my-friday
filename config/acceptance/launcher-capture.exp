#!/usr/bin/expect -f
if {$argc != 4} { exit 64 }
set timeout -1
set transcript [lindex $argv 0]
set marker [lindex $argv 1]
set launcher [lindex $argv 2]
set prompt [lindex $argv 3]
if {[file pathtype $transcript] ne "absolute"} { exit 64 }
if {$marker eq ""} { exit 64 }
if {[string first $marker $prompt] >= 0} { exit 65 }
if {[catch {set transcript_fd [open $transcript {WRONLY CREAT EXCL} 0600]}]} { exit 73 }
fconfigure $transcript_fd -translation binary -encoding binary
set stty_init "rows 30 columns 120"
log_user 0
log_file -a -open $transcript_fd
spawn -noecho $launcher

proc child_eof {} {
  global transcript_fd
  set status [wait]
  log_file
  set child_status [lindex $status 3]
  if {$child_status != 0} { exit $child_status }
  exit 1
}
proc pre_submit_marker {} {
  log_file
  close
  catch wait
  exit 65
}
proc drain_pending_output {} {
  global marker timeout expect_out
  set prior_timeout $timeout
  set timeout 0
  set marker_window ""
  expect {
    -re {(.|\n)} {
      append marker_window $expect_out(0,string)
      if {[string first $marker $marker_window] >= 0} { pre_submit_marker }
      if {[string length $marker_window] > [string length $marker]} {
        set marker_window [string range $marker_window end-[string length $marker] end]
      }
      exp_continue
    }
    eof { child_eof }
    timeout {}
  }
  set timeout $prior_timeout
}

expect {
  -exact $marker { pre_submit_marker }
  -exact "\033\[>7u" {}
  eof { child_eof }
}
expect {
  -exact $marker { pre_submit_marker }
  -exact "Ask Codex to do anything" {}
  eof { child_eof }
}
expect {
  -exact $marker { pre_submit_marker }
  -re {(Booting MCP server:|Starting MCP servers)} { exp_continue }
  -exact "\033]0;workspace\007" {}
  -exact "\033]0;workspace\033\\" {}
  eof { child_eof }
}
expect {
  -exact $marker { pre_submit_marker }
  -exact "Ask Codex to do anything" {}
  eof { child_eof }
}
set timeout 0
expect {
  -exact $marker { pre_submit_marker }
  eof { child_eof }
  timeout {}
}
set timeout -1
drain_pending_output
send -- $prompt
if {[string match {$capability-builder *} $prompt]} {
  set mention {$capability-builder}
  set task [string range $prompt [expr {[string length $mention] + 1}] end]
  set selected_suffix "  $task"
  expect {
    -exact $marker { pre_submit_marker }
    -exact "capability-builder" {}
    eof { child_eof }
  }
  expect {
    -exact $marker { pre_submit_marker }
    -exact "Help define, scaffold, inspect, validate, and test" {}
    eof { child_eof }
  }
  expect {
    -exact $marker { pre_submit_marker }
    -exact " to insert" {}
    eof { child_eof }
  }
  drain_pending_output
  send -- "\033\[13;1u"
  expect {
    -exact $marker { pre_submit_marker }
    -exact $selected_suffix {}
    eof { child_eof }
  }
  drain_pending_output
}
send -- "\033\[13;1u"
expect {
  -exact $marker {
    close
    catch wait
    log_file
    exit 0
  }
  eof { child_eof }
}
