#!/usr/bin/expect -f
if {$argc != 2} { exit 64 }
set timeout 40
set launcher [lindex $argv 0]
set token [lindex $argv 1]
spawn -noecho $launcher
expect {
  -exact "\033\[>7u" {}
  timeout { exit 1 }
  eof { exit 1 }
}
send -- "Return only the exact installed-purpose token."
send -- "\033\[13;1u"
expect {
  -exact $token {}
  timeout { exit 1 }
  eof { exit 1 }
}
close
catch wait
