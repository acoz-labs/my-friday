#!/usr/bin/expect -f
if {$argc != 2} { exit 64 }
set timeout 80
set launcher [lindex $argv 0]
set token [lindex $argv 1]
set stty_init "rows 30 columns 120"
spawn -noecho $launcher
expect {
  -exact "\033\[>7u" {}
  timeout { exit 1 }
  eof { exit 1 }
}
expect {
  -exact "Ask Codex to do anything" {}
  timeout { exit 1 }
  eof { exit 1 }
}
expect {
  -re {(Booting MCP server:|Starting MCP servers)} {}
  timeout { exit 1 }
  eof { exit 1 }
}
expect {
  -exact "\033]0;workspace\007" {}
  -exact "\033]0;workspace\033\\" {}
  timeout { exit 1 }
  eof { exit 1 }
}
expect {
  -exact "Ask Codex to do anything" {}
  timeout { exit 1 }
  eof { exit 1 }
}
send -- "Return only the exact installed-purpose token."
send -- "\033\[13;1u"
expect {
  -exact $token {}
  timeout { exit 1 }
  eof { exit 1 }
}
close
catch wait
