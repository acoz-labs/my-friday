#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"; supervisor="$root/bin/accept-installed-codex-baseline"
workshop="$root/bin/accept-capability-workshop"
grep -Fq 'umask 077' "$supervisor"
[[ "$(grep -n '^umask 077$' "$supervisor" | cut -d: -f1)" -lt "$(grep -n '^root=' "$supervisor" | cut -d: -f1)" ]]
grep -Fq 'mount_nlink="$(stat -f %l "$mountpoint")"' "$supervisor"
grep -Fq 'mount_nlink -ge 1 && mount_nlink -le 64' "$supervisor"
grep -Fq 'current_mount_nlink="$(stat -f %l "$mountpoint")"' "$supervisor"
grep -Fq 'mount_nlink="$(stat -f %l "$mountpoint")"' "$supervisor"
if grep -Fq '$mount_mode:$mount_nlink"' "$supervisor"; then exit 1; fi
[[ "$(grep -n 'failure_class="containment"' "$supervisor" | tail -1 | cut -d: -f1)" -lt "$(grep -n 'mount_nlink="$(stat -f %l "$mountpoint")"' "$supervisor" | tail -1 | cut -d: -f1)" ]]
if grep -Eq 'OPENAI_API_KEY|login --with-api-key| codex login ' "$supervisor"; then exit 1; fi
grep -Fq 'auth.json' "$supervisor"
grep -Fq 'dscl . -read "/Users/$(id -un)" NFSHomeDirectory' "$supervisor"
grep -Fq -- '--env HOME="$volume/home"' "$supervisor"
grep -Fq 'cmp "$acceptance_auth_file" "$primary_root/codex/auth.json"' "$supervisor"
if grep -Fq '/usr/bin/script -q /dev/null' "$supervisor"; then exit 1; fi
grep -Fq 'config/acceptance/launcher-smoke.exp' "$supervisor"
grep -Fq 'spawn -noecho $launcher' "$root/config/acceptance/launcher-smoke.exp"
grep -Fq 'set stty_init "rows 30 columns 120"' "$root/config/acceptance/launcher-smoke.exp"
grep -Fq -- '-exact "\033\[>7u"' "$root/config/acceptance/launcher-smoke.exp"
grep -Fq -- '-exact "Ask Codex to do anything"' "$root/config/acceptance/launcher-smoke.exp"
grep -Fq -- '-re {(Booting MCP server:|Starting MCP servers)}' "$root/config/acceptance/launcher-smoke.exp"
grep -Fq -- '-exact "\033]0;workspace\007"' "$root/config/acceptance/launcher-smoke.exp"
grep -Fq -- '-exact "\033]0;workspace\033\\"' "$root/config/acceptance/launcher-smoke.exp"
if grep -Eq 'quiescen|bootstrap_deadline|post_boot_composer' "$root/config/acceptance/launcher-smoke.exp"; then exit 1; fi
if grep -Eq '^after [0-9]+' "$root/config/acceptance/launcher-smoke.exp"; then exit 1; fi
grep -Fq 'send -- "\033\[13;1u"' "$root/config/acceptance/launcher-smoke.exp"
prompt_send_line="$(grep -nF 'send -- $prompt' "$root/config/acceptance/launcher-smoke.exp" | cut -d: -f1)"
prompt_prefix_line="$(grep -nF -- '-exact $prompt_prefix' "$root/config/acceptance/launcher-smoke.exp" | cut -d: -f1)"
prompt_suffix_line="$(grep -nF -- '-exact $prompt_suffix' "$root/config/acceptance/launcher-smoke.exp" | cut -d: -f1)"
enter_send_line="$(grep -nF 'send -- "\033\[13;1u"' "$root/config/acceptance/launcher-smoke.exp" | cut -d: -f1)"
[[ -n "$prompt_send_line" && -n "$prompt_prefix_line" && -n "$prompt_suffix_line" && -n "$enter_send_line" ]]
(( prompt_send_line < prompt_prefix_line && prompt_prefix_line < prompt_suffix_line && prompt_suffix_line < enter_send_line ))
if grep -Fq 'installed-purpose token.\r' "$root/config/acceptance/launcher-smoke.exp"; then exit 1; fi
if grep -Eiq 'continue anyway|trust( this)? (workspace|folder)|send.*(yes|y\\r)' "$root/config/acceptance/launcher-smoke.exp"; then exit 1; fi
grep -Fq -- '--env TERM=xterm-256color' "$supervisor"
grep -Fq -- '--timeout 90s "${candidate_env[@]}" --env TERM=xterm-256color' "$supervisor"
if grep -Fq 'TERM="${TERM' "$supervisor"; then exit 1; fi
grep -Fq 'cleanup-named --home "$real_home"' "$supervisor"
grep -Fq 'cleanup_named_state' "$supervisor"
grep -Fq 'cleanup_named_state || true' "$supervisor"
grep -Fq 'shell_canary_equal' "$supervisor"
grep -Fq 'launcher_sibling_equal' "$supervisor"
grep -Fq 'ambient_codex_stable_subset_equal' "$supervisor"
grep -Fq 'ambient_codex_metadata_excluded' "$supervisor"
if grep -Fq 'ambient_codex_equal' "$supervisor"; then exit 1; fi
for phase in primary-created secondary-created collision-created recovery-complete auth-copied smoke-complete; do
  grep -Fq "named_phase=\"$phase\"" "$supervisor"
done
for scenario in create verify pty_launch two_instance_isolation collision interrupted_remove_recovery reversal ambient_state_preservation file_backed_smoke; do
  grep -Fq "$scenario" "$supervisor"
done
if grep -Fq 'repair --runtime' "$supervisor"; then exit 1; fi
grep -Fq 'acceptance-support" fixture' "$supervisor"
grep -Fq 'acceptance-runner" --cwd' "$supervisor"
grep -Fq 'verify_mount_authority' "$supervisor"
# shellcheck disable=SC2016
grep -Fq 'git hash-object "$tracked"' "$supervisor"
grep -Fq 'failure-v1:comment=' "$supervisor"
# shellcheck disable=SC2016
grep -Fq 'resolve-executable "$codex_command"' "$supervisor"
grep -Fq 'render-profile --template' "$supervisor"
if grep -Eq 'sed .*@@VOLUME@@' "$supervisor"; then exit 1; fi
grep -Fq 'source_closure_sha256' "$supervisor"
grep -Fq 'go list -deps -json' "$supervisor"
grep -Fq 'if ! dependency_json=' "$supervisor"
for executed_script in bin/prepare-release-artifact bin/package-release-artifact bin/verify-acceptance-evidence; do grep -Fq "$executed_script" "$supervisor"; done
grep -Fq 'attach_started=1' "$supervisor"
grep -Fq -- '--expected-entry' "$supervisor"
grep -Fq 'file-write-data (literal "/dev/null")' "$root/config/acceptance/lifecycle.sb.in"
grep -Fq 'verify_detached_absence' "$supervisor"
grep -Fq 'cleanup-roots --home' "$supervisor"
grep -Fq 'candidate-like lifecycle launch control failed' "$supervisor"
grep -Fq 'setsid descendant control' "$supervisor"
grep -Fq 'protected-metadata' "$supervisor"
grep -Fq 'published evidence did not survive exact re-fetch verification' "$supervisor"
grep -Fq 'fetch_stable' "$root/bin/verify-acceptance-evidence"
grep -Fq '(?:evidence-v1|failure-v1|capability-workshop-acceptance-v1|capability-workshop-failure-v1)' "$root/bin/record-product-acceptance"
grep -Fq 'this supervisor is scoped to issue 51' "$workshop"
grep -Fq 'capability-workshop-acceptance-evidence-v1' "$workshop"
grep -Fq 'MY_FRIDAY_CODEX_AUTH_FILE' "$workshop"
grep -Fq 'builder_has_no_mutation_token:true' "$workshop"
grep -Fq 'stale capability plan' "$root/config/acceptance/capability-stale.exp"
grep -Fq 'No changes made' "$root/config/acceptance/capability-exit.exp"
grep -Fq 'acceptance-runner" --cwd' "$workshop"
grep -Fq 'secure-roots --home' "$workshop"
grep -Fq 'copy-auth --source' "$workshop"
grep -Fq 'cleanup-roots --home' "$workshop"
grep -Fq 'capability-stop-barrier' "$workshop"
grep -Fq 'DAILY_BRIEF_ABSENT' "$workshop"
grep -Fq 'sibling_before' "$workshop"
grep -Fq 'before_builder' "$workshop"
grep -Fq "trap - EXIT INT TERM" "$workshop"
if grep -Eq 'cp -p .*auth|rm -rf.*(run_root|instance_root|sibling_root)' "$workshop"; then exit 1; fi
for scenario in builder install upgrade denials interruption migration cleanup; do grep -Fq "phase=$scenario" "$workshop"; done
for command in verify-capability-workshop-evidence verify-capability-workshop-receipt verify-capability-workshop-acceptance record-capability-workshop-receipt; do [[ -x "$root/bin/$command" ]]; done
grep -Fq 'elif [[ "$issue_number" == 51 ]]' "$root/bin/record-product-acceptance"
grep -Fq 'elif [[ "$issue_number" == 51 ]]' "$root/bin/finalize-release"
grep -Fq '(subpath @@VOLUME@@)' "$root/config/acceptance/lifecycle.sb.in"
if grep -Eq 'rm -rf.*(run_root|evidence_root|run_parent|evidence_parent)' "$supervisor"; then exit 1; fi
echo "acceptance contract tests passed."
