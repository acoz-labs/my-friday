#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
fixture="$tmp/my-friday"
printf '#!/bin/sh\necho fixture\n' > "$fixture"
chmod 0755 "$fixture"
digest="$(sha256sum "$fixture" | awk '{print $1}')"

"$root/bin/package-release-artifact" "$fixture" "$digest" "$tmp/one" >/dev/null
touch -t 203001010101 "$fixture"
"$root/bin/package-release-artifact" "$fixture" "$digest" "$tmp/two" >/dev/null
cmp "$tmp/one/my-friday-darwin-arm64.tar.gz" "$tmp/two/my-friday-darwin-arm64.tar.gz"
cmp "$tmp/one/SHA256SUMS" "$tmp/two/SHA256SUMS"
[[ "$(tar -tzf "$tmp/one/my-friday-darwin-arm64.tar.gz")" == my-friday ]]
mkdir "$tmp/extract"
tar -xzf "$tmp/one/my-friday-darwin-arm64.tar.gz" -C "$tmp/extract"
cmp "$fixture" "$tmp/extract/my-friday"
[[ -x "$tmp/extract/my-friday" ]]
if "$root/bin/package-release-artifact" "$fixture" "$(printf '0%.0s' {1..64})" "$tmp/bad" 2>/dev/null; then
  echo "Packaging accepted a mismatched executable digest." >&2
  exit 1
fi

mkdir "$tmp/mock-bin"
cat > "$tmp/mock-bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
log="${GH_MOCK_LOG:?}"
state="${GH_MOCK_STATE:?}"
if [[ "$1 $2" == "release view" ]]; then
  digest="$(sha256sum "${LOCAL_ASSET:?}" | awk '{print $1}')"
  case "$(cat "$state")" in
    missing) printf '{"assets":[]}\n' ;;
    equal) printf '{"assets":[{"name":"my-friday-darwin-arm64.tar.gz","digest":"sha256:%s"}]}\n' "$digest" ;;
    mismatch) printf '{"assets":[{"name":"my-friday-darwin-arm64.tar.gz","digest":"sha256:%064d"}]}\n' 0 ;;
  esac
elif [[ "$1 $2" == "release upload" ]]; then
  printf 'upload\n' >> "$log"
else
  echo "Unexpected gh invocation: $*" >&2
  exit 2
fi
EOF
chmod +x "$tmp/mock-bin/gh"
export PATH="$tmp/mock-bin:$PATH" GITHUB_REPOSITORY=owner/repo GH_MOCK_LOG="$tmp/gh.log"
export GH_MOCK_STATE="$tmp/state" LOCAL_ASSET="$tmp/one/my-friday-darwin-arm64.tar.gz"
: > "$GH_MOCK_LOG"
printf missing > "$GH_MOCK_STATE"
"$root/bin/release-assets" tag "$LOCAL_ASSET"
[[ "$(wc -l < "$GH_MOCK_LOG" | tr -d ' ')" == 1 ]]
printf equal > "$GH_MOCK_STATE"
"$root/bin/release-assets" tag "$LOCAL_ASSET"
[[ "$(wc -l < "$GH_MOCK_LOG" | tr -d ' ')" == 1 ]]
printf mismatch > "$GH_MOCK_STATE"
if "$root/bin/release-assets" tag "$LOCAL_ASSET" 2>/dev/null; then
  echo "Release retry accepted a mismatched existing asset." >&2
  exit 1
fi

source_name="my-friday-darwin-arm64-deadbee.tar.gz"
cp "$tmp/one/my-friday-darwin-arm64.tar.gz" "$tmp/$source_name"
source_digest="$(sha256sum "$tmp/$source_name" | awk '{print $1}')"
printf '%s  %s\n%s  my-friday\n' "$source_digest" "$source_name" "$digest" > "$tmp/SHA256SUMS"
cat > "$tmp/mock-bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$1 $2" == "release view" && " $* " == *" --jq .tagName "* ]]; then
  printf '%s\n' "${BACKFILL_TAG:?}"
elif [[ "$1 $2" == "release view" && " $* " == *" tagName,isDraft,isPrerelease,body,assets "* ]]; then
  printf '{"tagName":"%s","isDraft":false,"isPrerelease":false,"body":"%s","assets":[{"name":"%s"},{"name":"SHA256SUMS"}]}\n' \
    "${BACKFILL_TAG:?}" "${BACKFILL_BODY:?}" "${BACKFILL_SOURCE_NAME:?}"
elif [[ "$1 $2" == "release view" ]]; then
  printf '{"assets":[]}\n'
elif [[ "$1 $2" == "release download" ]]; then
  destination="${@: -1}"
  cp "${BACKFILL_FIXTURES:?}/${BACKFILL_SOURCE_NAME:?}" "$destination/"
  cp "${BACKFILL_FIXTURES:?}/SHA256SUMS" "$destination/"
elif [[ "$1 $2" == "release upload" ]]; then
  printf 'backfill-upload\n' >> "${GH_MOCK_LOG:?}"
else
  echo "Unexpected gh invocation: $*" >&2
  exit 2
fi
EOF
chmod +x "$tmp/mock-bin/gh"
export BACKFILL_TAG=artifact-2026.01.01-deadbee BACKFILL_SOURCE_NAME="$source_name" BACKFILL_FIXTURES="$tmp"
export BACKFILL_BODY="- Artifact: \`sha256:$digest\`"
: > "$GH_MOCK_LOG"
"$root/bin/backfill-stable-release-asset" "$BACKFILL_TAG" "$source_name" "$digest"
[[ "$(grep -c backfill-upload "$GH_MOCK_LOG")" == 1 ]]

legacy_entry="my-friday-darwin-arm64-5bc3092"
legacy_source="my-friday-darwin-arm64-5bc3092.tar.gz"
mkdir "$tmp/legacy-stage"
install -m 0755 "$fixture" "$tmp/legacy-stage/$legacy_entry"
tar -czf "$tmp/$legacy_source" -C "$tmp/legacy-stage" "$legacy_entry"
legacy_source_digest="$(sha256sum "$tmp/$legacy_source" | awk '{print $1}')"
printf '%s  %s\n%s  %s\n' \
  "$legacy_source_digest" "$legacy_source" "$digest" "$legacy_entry" > "$tmp/SHA256SUMS"
BACKFILL_SOURCE_NAME="$legacy_source"
export BACKFILL_SOURCE_NAME
"$root/bin/backfill-stable-release-asset" "$BACKFILL_TAG" "$legacy_source" "$digest"
[[ "$(grep -c backfill-upload "$GH_MOCK_LOG")" == 2 ]]

BACKFILL_BODY="- Artifact: \`sha256:$(printf '0%.0s' {1..64})\`"
export BACKFILL_BODY
if "$root/bin/backfill-stable-release-asset" "$BACKFILL_TAG" "$legacy_source" "$digest" 2>/dev/null; then
  echo "Backfill accepted a Release-ledger digest mismatch." >&2
  exit 1
fi
BACKFILL_BODY="- Artifact: \`sha256:$digest\`\\n- Artifact: \`sha256:$digest\`"
export BACKFILL_BODY
if "$root/bin/backfill-stable-release-asset" "$BACKFILL_TAG" "$legacy_source" "$digest" 2>/dev/null; then
  echo "Backfill accepted ambiguous Release-ledger authority." >&2
  exit 1
fi
if "$root/bin/backfill-stable-release-asset" "$BACKFILL_TAG" "$legacy_source" "$(printf '0%.0s' {1..64})" 2>/dev/null; then
  echo "Backfill accepted a mismatched contained executable." >&2
  exit 1
fi

cat > "$tmp/mock-bin/gh" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${GH_MOCK_LOG:?}"
exit 99
EOF
chmod +x "$tmp/mock-bin/gh"
: > "$GH_MOCK_LOG"
if GITHUB_REPOSITORY=owner/repo RELEASE_SHA="$(git -C "$root" rev-parse HEAD)" \
  RELEASE_ARTIFACT=test RELEASE_ISSUES=17 RELEASE_SUMMARY=test \
  RELEASE_ASSET_PATHS="$tmp/missing:wrong" \
  "$root/bin/finalize-release" artifact 2>/dev/null; then
  echo "Finalizer accepted malformed release asset paths." >&2
  exit 1
fi
[[ ! -s "$GH_MOCK_LOG" ]] || { echo "Malformed asset paths reached GitHub mutation boundary." >&2; exit 1; }

grep -Fq 'name: my-friday-darwin-arm64' "$root/.github/workflows/nominate-artifact.yml"
grep -Fq "bin/prepare-release-artifact" "$root/.github/workflows/release-artifact.yml"
for workflow in release-artifact.yml backfill-stable-release.yml; do
  if awk '
    /^[[:space:]]+run:/ { in_run=1 }
    in_run && /\$\{\{[[:space:]]*inputs\./ { found=1 }
    in_run && /^[[:space:]]+- name:/ { in_run=0 }
    END { exit found ? 0 : 1 }
  ' "$root/.github/workflows/$workflow"; then
    echo "$workflow interpolates dispatch input into shell source." >&2
    exit 1
  fi
done
if grep -Eq 'go build|make build' "$root/.github/workflows/release-artifact.yml"; then
  echo "Release workflow rebuilds the accepted executable." >&2
  exit 1
fi

echo "release asset tests passed."
