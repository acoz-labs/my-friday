#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -x /usr/bin/expect ]]; then
  echo "Launcher PTY capture integration skipped: /usr/bin/expect unavailable."
  exit 0
fi
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
go build -o "$tmp/acceptance-runner" "$root/tools/acceptance-runner"

cat >"$tmp/fake-tui" <<'EOF'
#!/bin/bash
set -euo pipefail
printf spawned >"$TUI_SPAWNED"
[[ "$#" == 1 ]] || exit 91
[[ -t 1 ]] || exit 90
printf '%s' "$1" >"$TUI_SUBMITTED"
case "${TUI_MODE:-success}" in
  success) printf '%s\n' "$TUI_MARKER"; sleep 30 ;;
  framed) printf '\033[31mextra prose %s trailing prose\033[0m\n' "$TUI_MARKER"; sleep 30 ;;
  fragmented) printf '%s' "${TUI_MARKER:0:${#TUI_MARKER}/2}"; sleep 0.2; printf '%s\n' "${TUI_MARKER:${#TUI_MARKER}/2}"; sleep 30 ;;
  fragment-only) printf '%s' "${TUI_MARKER:0:${#TUI_MARKER}/2}"; exit 0 ;;
  missing) exit 0 ;;
  nonzero) printf 'PRIVATE_FAILURE\n'; exit 37 ;;
  descendant)
    trap 'kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; exit 0' HUP
    sleep 30 & child=$!
    printf '%s\n' "$child" >"$TUI_CHILD_PID"
    sync "$TUI_CHILD_PID" 2>/dev/null || sync
    printf '%s\n' "$TUI_MARKER"
    wait "$child"
    ;;
esac
EOF
chmod 0700 "$tmp/fake-tui"

run_tui() {
  local mode="$1" transcript="$2" marker="$3" prompt="$4"
  "$tmp/acceptance-runner" --cwd "$tmp" --timeout 5s \
    --env PATH=/usr/bin:/bin --env TUI_MODE="$mode" --env TUI_MARKER="$marker" \
    --env TUI_SUBMITTED="$tmp/submitted" --env TUI_SPAWNED="$tmp/spawned" \
    --env TUI_CHILD_PID="$tmp/child.pid" -- \
    /usr/bin/expect "$root/config/acceptance/launcher-capture.exp" "$transcript" "$marker" "$tmp/fake-tui" "$prompt"
}

for prompt in '--option-shaped' 'white space prompt' 'literal $dollar ; semicolon * glob [brackets]'; do
  rm -f "$tmp/spawned" "$tmp/submitted"
  output="$(run_tui success "$tmp/success.private" "DONE_${RANDOM}" "$prompt")"
  [[ -z "$output" ]]
  [[ "$(cat "$tmp/submitted")" == "$prompt" ]]
  [[ "$(stat -f %Lp "$tmp/success.private" 2>/dev/null || stat -c %a "$tmp/success.private")" == 600 ]]
  rm "$tmp/success.private"
done

run_tui fragmented "$tmp/fragmented.private" FRAGMENTED_COMPLETE 'fragmented completion prompt'
[[ "$(LC_ALL=C tr -d '\r' <"$tmp/fragmented.private" | LC_ALL=C grep -Fxc FRAGMENTED_COMPLETE)" == 1 ]]
run_tui framed "$tmp/framed.private" FRAMED_COMPLETE 'framed completion prompt'
[[ "$(LC_ALL=C tr -d '\r' <"$tmp/framed.private" | LC_ALL=C grep -Fxc FRAMED_COMPLETE)" == 1 ]]

set +e
run_tui missing "$tmp/missing.private" NEVER_SEEN 'missing prompt'
missing_status=$?
run_tui fragment-only "$tmp/fragment-only.private" NEVER_COMPLETE 'fragment-only prompt'
fragment_only_status=$?
run_tui nonzero "$tmp/nonzero.private" NEVER_SEEN 'nonzero prompt'
nonzero_status=$?
rm -f "$tmp/spawned"
/usr/bin/expect "$root/config/acceptance/launcher-capture.exp" "$tmp/self.private" SELF_MARKER "$tmp/fake-tui" 'prompt contains SELF_MARKER'
self_status=$?
set -e
[[ "$missing_status" == 1 ]]
[[ "$fragment_only_status" == 1 ]]
[[ "$nonzero_status" == 37 ]]
[[ "$self_status" == 65 ]]
[[ ! -e "$tmp/spawned" && ! -e "$tmp/self.private" ]]
grep -Fq PRIVATE_FAILURE "$tmp/nonzero.private"

run_tui descendant "$tmp/descendant.private" TUI_COMPLETE 'descendant prompt'
child_pid="$(cat "$tmp/child.pid")"
if kill -0 "$child_pid" 2>/dev/null; then
  echo "marker-triggered PTY closure left a descendant" >&2
  exit 1
fi

grep -Fq 'spawn -noecho {*}[list $launcher $prompt]' "$root/config/acceptance/launcher-capture.exp"
go test ./tools/acceptance-runner -run 'TestRunner(PTYWrappedTimeoutReapsEscapedDescendant|PTYWrappedSignalsReapDescendants)$'

echo "Launcher PTY capture tests passed."
