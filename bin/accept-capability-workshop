#!/usr/bin/env bash
set -euo pipefail
umask 077
authority="${1:-}" issue="${2:-}" repo="${GITHUB_REPOSITORY:-}" root="$(cd "$(dirname "$0")/.." && pwd)"
auth_file="${MY_FRIDAY_CODEX_AUTH_FILE:-}" runtime_projection="${MY_FRIDAY_RUNTIME_PROJECTION:-}"
pattern='^artifact-v1:run=([0-9]+):id=([0-9]+):name=([A-Za-z0-9._-]+):sha256=([0-9a-f]{64})$'
refuse(){ echo "$*" >&2; exit 1; }
[[ "$issue" == 51 && "$authority" =~ $pattern ]] || refuse "this supervisor is scoped to issue 51 and artifact-v1"
artifact_digest="${BASH_REMATCH[4]}"
[[ -n "$repo" && "$auth_file" == /*/auth.json && "$runtime_projection" == /* ]] || refuse "absolute runtime and auth.json paths required"
[[ "$(uname -s):$(uname -m)" == Darwin:arm64 && -t 0 && -t 1 ]] || refuse "interactive Apple silicon macOS required"
for c in gh git go jq hdiutil diskutil shasum sha256sum expect codex openssl plutil perl tar uuidgen mount; do command -v "$c" >/dev/null || refuse "$c required"; done
head_sha="$(git rev-parse HEAD)"; [[ -z "$(git status --porcelain)" && "$(git rev-parse --show-toplevel)" == "$root" ]] || refuse "exact clean checkout required"
real_home="$(dscl . -read "/Users/$(id -un)" NFSHomeDirectory|awk '{print $2}')"
go run ./tools/acceptance-support validate-root --path "$runtime_projection" >/dev/null || refuse "runtime ancestry unsafe"
runtime_projection="$(cd "$runtime_projection" && pwd -P)"; go run ./tools/acceptance-support validate-runtime "$runtime_projection" || refuse "runtime invalid"
run_id="$(uuidgen|tr '[:upper:]' '[:lower:]'|tr -d '-')"; nonce="$(openssl rand -hex 16)"
run_root="$real_home/.my-friday-acceptance/$run_id"; evidence_root="$real_home/.my-friday-acceptance-evidence/$run_id"
instance="mfcw-${run_id:0:8}"; sibling="mfcw-${run_id:8:8}"; instance_root="$real_home/.my-friday/assistants/$instance"; sibling_root="$real_home/.my-friday/assistants/$sibling"; launcher="$real_home/.local/bin/$instance"; sibling_launcher="$real_home/.local/bin/$sibling"
for leaf in "$instance_root" "$sibling_root" "$launcher" "$sibling_launcher"; do [[ ! -e "$leaf" && ! -L "$leaf" ]] || refuse "random leaf collision"; done
root_ids="$(go run ./tools/acceptance-support secure-roots --home "$real_home" --run-id "$run_id")" || refuse "secure roots failed"
marker_body="$(jq -nc --arg run "$run_id" --arg nonce "$nonce" --arg home "$real_home" --arg sha "$head_sha" --arg artifact "$authority" --argjson uid "$(id -u)" --argjson gid "$(id -g)" --argjson roots "$root_ids" '{schema:"capability-workshop-run-v1",issue:51,run:$run,nonce:$nonce,home:$home,candidate:$sha,artifact:$artifact,uid:$uid,gid:$gid,roots:$roots}')"
for marker in "$run_root/marker.json" "$evidence_root/marker.json"; do printf '%s\n' "$marker_body" >"$marker"; done
marker_sha="$(shasum -a 256 "$run_root/marker.json"|awk '{print $1}')"; cmp "$run_root/marker.json" "$evidence_root/marker.json" >/dev/null
ambient_before="$(find "$real_home/.codex" -xdev -mindepth 1 ! -path '*/sessions*' ! -path '*/sessions/*' ! -name 'state_*.sqlite*' ! -name 'logs_*.sqlite*' -exec stat -f '%N:%d:%i:%p:%z:%m' {} + 2>/dev/null|LC_ALL=C sort|shasum -a 256|awk '{print $1}')";runtime_before="$(find "$runtime_projection" -xdev -exec stat -f '%N:%d:%i:%p:%z:%m' {} +|LC_ALL=C sort|shasum -a 256|awk '{print $1}')";home_before="$(for leaf in .zshrc .zprofile .profile .bashrc;do [[ ! -e "$real_home/$leaf" ]]||stat -f '%N:%d:%i:%p:%z:%m' "$real_home/$leaf";done|shasum -a 256|awk '{print $1}')"
phase=pre-create mounted=0 device="" volume_uuid="" image_identity="" target_owned=0 sibling_owned=0
source="$instance_root/runtime/skills/daily-brief"; projection="$instance_root/workspace/.agents/skills/daily-brief"; image="$run_root/workshop.sparseimage"; mountpoint="$run_root/mount"; artifact_dir="$run_root/artifact"
mkdir "$mountpoint" "$artifact_dir"
for tool in acceptance-support acceptance-runner capability-stop-barrier source-workshop-stop-barrier; do CGO_ENABLED=0 go build -trimpath -buildvcs=true -o "$run_root/$tool" "./tools/$tool"; done
install -m 0500 "$root/config/acceptance/launcher-capture.exp" "$run_root/launcher-capture.exp"
run_with_timeout(){ local timeout="$1";shift;"$run_root/acceptance-runner" --cwd "$real_home" --timeout "$timeout" --env HOME="$real_home" --env LANG=en_US.UTF-8 --env PATH="$(dirname "$(command -v codex)"):/usr/bin:/bin:/usr/sbin:/sbin" -- "$@"; }
run_clean(){ run_with_timeout 180s "$@"; }
run_private(){ local transcript="$1" marker="$2";shift 2;run_with_timeout 600s /usr/bin/expect "$run_root/launcher-capture.exp" "$transcript" "$marker" "$@"; }
private_line(){ LC_ALL=C tr -d '\r' <"$1"|LC_ALL=C grep -Fqx "$2"; }
confirm(){ run_clean /usr/bin/expect "$root/config/acceptance/capability-confirm.exp" "$@"; }
tree_digest(){ local base="$1" x="${2:-}" y="${3:-}"; find "$base" -xdev -print0|LC_ALL=C sort -z|while IFS= read -r -d '' p; do [[ -n "$x" && ( "$p" == "$x" || "$p" == "$x/"* ) ]]&&continue; [[ -n "$y" && ( "$p" == "$y" || "$p" == "$y/"* ) ]]&&continue; if [[ -f "$p" && ! -L "$p" ]]; then printf '%s:%s:%s\n' "${p#"$base"}" "$(stat -f %p "$p")" "$(shasum -a 256 "$p"|awk '{print $1}')"; elif [[ -L "$p" ]]; then printf '%s:link:%s\n' "${p#"$base"}" "$(readlink "$p")"; else printf '%s:dir:%s\n' "${p#"$base"}" "$(stat -f %p "$p")"; fi; done|shasum -a 256|awk '{print $1}'; }
verify_mount(){ [[ "$mounted" == 1 && -n "$device" && -n "$volume_uuid" && "$(stat -f %d:%i:%u:%p:%l "$image" 2>/dev/null)" == "$image_identity" && "$(diskutil info -plist "$device" 2>/dev/null|plutil -extract MountPoint raw -o - - 2>/dev/null)" == "$mountpoint" && "$(diskutil info -plist "$device" 2>/dev/null|plutil -extract VolumeUUID raw -o - - 2>/dev/null)" == "$volume_uuid" && "$(shasum -a 256 "$run_root/marker.json"|awk '{print $1}')" == "$marker_sha" && "$(shasum -a 256 "$evidence_root/marker.json"|awk '{print $1}')" == "$marker_sha" ]]; }
cleanup_named(){
  local args=(cleanup-named --home "$real_home" --candidate "$head_sha" --run-id "$run_id") receipt
  [[ "$target_owned" == 0 ]]||{ receipt="$(run_clean "$run_root/acceptance-support" codex-cleanup-receipt --home "$real_home" --name "$instance" --candidate "$head_sha" --run-id "$run_id")"||return 1; args+=(--name "$instance" --codex-receipt "$receipt"); }
  [[ "$sibling_owned" == 0 ]]||{ receipt="$(run_clean "$run_root/acceptance-support" codex-cleanup-receipt --home "$real_home" --name "$sibling" --candidate "$head_sha" --run-id "$run_id")"||return 1; args+=(--name "$sibling" --codex-receipt "$receipt"); }
  run_clean "$run_root/acceptance-support" "${args[@]}"
}
cleanup(){ status=$?; trap - EXIT INT TERM; set +e; cleaned=false detached=false; cleanup_named&&cleaned=true; if verify_mount&&hdiutil detach "$device" >/dev/null 2>&1&&! diskutil info "$device" >/dev/null 2>&1; then mounted=0;detached=true;fi; if [[ "$status" != 0 ]]; then failure="$(jq -nc --arg sha "$head_sha" --arg artifact "$authority" --arg run "$run_id" --arg phase "$phase" --argjson detached "$detached" --argjson cleaned "$cleaned" '{schema:"capability-workshop-acceptance-evidence-v1",authority:"failure",issue:51,candidate:$sha,artifact:$artifact,run_id:$run,failure_scope:"candidate",failure_class:"candidate",failure_phase:$phase,cleanup:{ambient_unchanged:false,credential_copy_deleted:$cleaned,detached:$detached,owned_state_removed:$cleaned},redacted:true}')"; body="<!-- capability-workshop-acceptance-evidence-v1 authority=failure -->
$failure"; if url="$(gh api -X POST "repos/$repo/issues/51/comments" -f body="$body" --jq .url 2>/dev/null)"; then printf 'capability-workshop-failure-v1:comment=%s:%s\n' "${url##*/}" "$(printf %s "$body"|shasum -a 256|awk '{print $1}')" >&2;fi;echo "Private diagnostic state preserved at $run_root and $evidence_root" >&2;fi;exit "$status"; }
trap cleanup EXIT; trap 'exit 130' INT; trap 'exit 143' TERM

phase=artifact; GITHUB_REPOSITORY="$repo" "$root/bin/prepare-release-artifact" "$authority" "$artifact_dir"; tar -xzf "$artifact_dir/my-friday-darwin-arm64.tar.gz" -C "$artifact_dir"; candidate="$artifact_dir/my-friday"; [[ "$(shasum -a 256 "$candidate"|awk '{print $1}')" == "$artifact_digest" ]]||refuse "candidate digest mismatch"; archive_digest="$(awk '$2=="my-friday-darwin-arm64.tar.gz"{print $1}' "$artifact_dir/SHA256SUMS")"
helper_closure="$(printf '%s\n' bin/accept-capability-workshop bin/prepare-release-artifact bin/verify-capability-workshop-evidence config/acceptance/capability-confirm.exp config/acceptance/capability-exit.exp config/acceptance/capability-workshop.exp config/acceptance/capability-workshop-abandon.exp config/acceptance/capability-workshop-recover.exp config/acceptance/launcher-capture.exp tools/acceptance-runner/main.go tools/acceptance-support/main.go tools/capability-stop-barrier/main.go tools/source-workshop-stop-barrier/main.go|while read -r f;do git hash-object "$f";done|shasum -a 256|awk '{print $1}')"
phase=isolation; hdiutil create -quiet -size 2g -type SPARSE -fs APFS -volname "MFCW-$run_id" "$image";image_identity="$(stat -f %d:%i:%u:%p:%l "$image")";attach="$(hdiutil attach -plist -nobrowse -mountpoint "$mountpoint" "$image")";device="$(printf '%s' "$attach"|"$run_root/acceptance-support" mounted-device --mountpoint "$mountpoint")";volume_uuid="$(diskutil info -plist "$device"|plutil -extract VolumeUUID raw -o - -)";mounted=1;verify_mount||refuse "APFS authority invalid"
"$run_root/acceptance-support" fixture --runtime "$mountpoint/runtime" --memory "$mountpoint/memory" --token "MFCW_$run_id"; phase=migration;confirm Rollback "$candidate" capability rollback --runtime "$mountpoint/runtime";confirm Initialize "$candidate" capability initialize --runtime "$mountpoint/runtime"
phase=instance;confirm Create "$candidate" assistant create "$instance" --runtime "$mountpoint/runtime" --memory "$mountpoint/memory";target_owned=1;confirm Create "$candidate" assistant create "$sibling" --runtime "$mountpoint/runtime" --memory "$mountpoint/memory";sibling_owned=1
[[ "$(jq -r .contract_version "$instance_root/manifest.json")" == 2 ]]||refuse "target not contract v2"; auth_receipt="$("$run_root/acceptance-support" copy-auth --source "$auth_file" --destination-dir "$instance_root/codex")";[[ "$(jq -r .schema<<<"$auth_receipt")" == auth-copy-receipt-v1 ]]||refuse "auth receipt missing";sibling_before="$(tree_digest "$sibling_root")"
phase=workshop;before_workshop="$(tree_digest "$instance_root" "$instance_root/codex" "$source")";for abandon in q eof int term;do run_clean /usr/bin/expect "$root/config/acceptance/capability-workshop-abandon.exp" "$abandon" "$candidate" "$instance" daily-brief;[[ ! -e "$source"&&! -e "$instance_root/capabilities/.workshop-daily-brief.json" ]]||refuse "abandoned workshop changed source";done;run_clean /usr/bin/expect "$root/config/acceptance/capability-workshop.exp" create "$candidate" "$instance" daily-brief "$evidence_root/workshop-create.private";[[ -d "$source"&&! -e "$projection"&&! -e "$instance_root/capabilities/daily-brief" ]]||refuse "workshop activated source";grep -Fq 'Source action: create' "$evidence_root/workshop-create.private";grep -Fq 'Post-write state: ready' "$evidence_root/workshop-create.private";"$candidate" capability validate "$instance" daily-brief>/dev/null;"$candidate" capability test "$instance" daily-brief>/dev/null
{ git diff --no-index --binary /dev/null "$source" 2>/dev/null||[[ "$?" == 1 ]];}|sed -E 's#(/[^[:space:]]*/daily-brief)#<CAPABILITY>#g'>"$evidence_root/source.diff.private";diff_digest="$(shasum -a 256 "$evidence_root/source.diff.private"|awk '{print $1}')"
phase=install;run_clean /usr/bin/expect "$root/config/acceptance/capability-exit.exp" "$candidate" capability install "$instance" daily-brief;[[ ! -e "$projection" ]]||refuse "safe exit activated";confirm Install "$candidate" capability install "$instance" daily-brief;"$candidate" capability verify "$instance" daily-brief>/dev/null;run_private "$evidence_root/invocation.private" DAILY_BRIEF_READY "$launcher" 'Explicitly invoke daily-brief and return its exact declared token.';LC_ALL=C grep -Fq DAILY_BRIEF_READY "$evidence_root/invocation.private"||refuse "fresh invocation failed"
phase=upgrade
mkdir "$source/skill/references";printf 'opaque-reference\n'>"$source/skill/references/acceptance.txt"
interrupt_canary="$source/skill/references/interruption-canary";mkdir "$interrupt_canary"
interrupt_padding="$(printf '%08192d' 0)"
for ((i=0;i<48;i++));do printf -v leaf '%03d' "$i";printf 'opaque-%s-%s\n' "$leaf" "$interrupt_padding">"$interrupt_canary/$leaf";done
opaque_before="$(tree_digest "$source/skill/references")"
run_clean /usr/bin/expect "$root/config/acceptance/capability-workshop.exp" enhance "$candidate" "$instance" daily-brief "$evidence_root/workshop-update.private"
[[ "$(tree_digest "$source/skill/references")" == "$opaque_before" ]]||refuse "opaque source changed"
grep -Fq 'Source action: update' "$evidence_root/workshop-update.private";grep -Fq 'Post-write state: source-changed' "$evidence_root/workshop-update.private";grep -Fq 'State: source-changed' <("$candidate" capability inspect "$instance" daily-brief --plain);"$candidate" capability test "$instance" daily-brief>/dev/null;confirm Upgrade "$candidate" capability upgrade "$instance" daily-brief
phase=source-interruption
"$run_root/source-workshop-stop-barrier" --expect "$root/config/acceptance/capability-workshop.exp" --candidate "$candidate" --instance "$instance" --instance-root "$instance_root" --slug daily-brief --transcript "$evidence_root/workshop-interrupted.private"
[[ "$(tree_digest "$source/skill/references")" == "$opaque_before" ]]||refuse "source interruption changed opaque canary tree"
grep -Fq 'State: interrupted' <("$candidate" capability inspect "$instance" daily-brief --plain);run_clean /usr/bin/expect "$root/config/acceptance/capability-workshop-recover.exp" "$candidate" "$instance" daily-brief;[[ ! -e "$instance_root/capabilities/.workshop-daily-brief.json" ]]||refuse "source workshop journal remains";"$candidate" capability verify "$instance" daily-brief>/dev/null
phase=denials;owned="$projection/SKILL.md";cp "$owned" "$evidence_root/owned.private";printf '\ndrift\n'>>"$owned";drift="$(shasum -a 256 "$owned"|awk '{print $1}')";"$candidate" capability disable "$instance" daily-brief>/dev/null 2>&1&&refuse "drift accepted";[[ "$(shasum -a 256 "$owned"|awk '{print $1}')" == "$drift" ]]||refuse "drift changed";mv "$evidence_root/owned.private" "$owned";confirm Disable "$candidate" capability disable "$instance" daily-brief;[[ ! -e "$projection"&&"$(jq -r .state "$instance_root/capabilities/daily-brief/receipt.json")" == disabled ]]||refuse "disabled state invalid";run_private "$evidence_root/disabled.private" DAILY_BRIEF_ABSENT "$launcher" 'Start a fresh task. If daily-brief is not available, reply with exactly one line formed by concatenating DAILY, underscore, BRIEF, underscore, and ABSENT. Do not simulate the capability.';private_line "$evidence_root/disabled.private" DAILY_BRIEF_ABSENT||refuse "disabled absence unobserved";if LC_ALL=C grep -Fq DAILY_BRIEF_READY "$evidence_root/disabled.private";then refuse "disabled skill behavior appeared";fi
mkdir "$projection";printf foreign>"$projection/foreign";"$candidate" capability enable "$instance" daily-brief>/dev/null 2>&1&&refuse "collision accepted";[[ "$(cat "$projection/foreign")" == foreign ]]||refuse "foreign changed";rm "$projection/foreign";rmdir "$projection";confirm Enable "$candidate" capability enable "$instance" daily-brief
phase=interruption;"$run_root/capability-stop-barrier" --expect "$root/config/acceptance/capability-confirm.exp" --candidate "$candidate" --instance "$instance" --instance-root "$instance_root" --slug daily-brief;grep -Fq 'State: interrupted' <("$candidate" capability inspect "$instance" daily-brief --plain);confirm Recover "$candidate" capability recover "$instance" daily-brief;"$candidate" capability verify "$instance" daily-brief>/dev/null;confirm Remove "$candidate" capability remove "$instance" daily-brief;[[ -d "$source"&&! -e "$projection" ]]||refuse "reversal failed"
phase=migration;confirm Rollback "$candidate" assistant rollback "$instance";confirm Upgrade "$candidate" assistant upgrade "$instance";[[ -d "$source" ]]||refuse "private source lost"
phase=cleanup;[[ "$(tree_digest "$sibling_root")" == "$sibling_before" ]]||refuse "sibling changed";auth_check="$("$run_root/acceptance-support" copy-auth --source "$auth_file" --destination-dir "$mountpoint/home")";[[ "$(jq -r '[.source_device,.source_inode,.sha256]|join(":")'<<<"$auth_check")" == "$(jq -r '[.source_device,.source_inode,.sha256]|join(":")'<<<"$auth_receipt")" ]]||refuse "auth source changed";rm "$mountpoint/home/auth.json";[[ "$(find "$real_home/.codex" -xdev -mindepth 1 ! -path '*/sessions*' ! -path '*/sessions/*' ! -name 'state_*.sqlite*' ! -name 'logs_*.sqlite*' -exec stat -f '%N:%d:%i:%p:%z:%m' {} + 2>/dev/null|LC_ALL=C sort|shasum -a 256|awk '{print $1}')" == "$ambient_before" ]]||refuse "ambient Codex changed";[[ "$(find "$runtime_projection" -xdev -exec stat -f '%N:%d:%i:%p:%z:%m' {} +|LC_ALL=C sort|shasum -a 256|awk '{print $1}')" == "$runtime_before" ]]||refuse "runtime changed";[[ "$(for leaf in .zshrc .zprofile .profile .bashrc;do [[ ! -e "$real_home/$leaf" ]]||stat -f '%N:%d:%i:%p:%z:%m' "$real_home/$leaf";done|shasum -a 256|awk '{print $1}')" == "$home_before" ]]||refuse "HOME canary changed";cleanup_named;target_owned=0;sibling_owned=0;verify_mount&&hdiutil detach "$device">/dev/null;mounted=0;! diskutil info "$device">/dev/null 2>&1||refuse "device remains"
tree="$(git rev-parse 'HEAD^{tree}')";supervisor_blob="$(git rev-parse HEAD:bin/accept-capability-workshop)";provisional="$(jq -nc --arg sha "$head_sha" --arg artifact "$authority" --arg run "$run_id" --arg tree "$tree" --arg supervisor "$supervisor_blob" --arg closure "$helper_closure" --arg executable "$artifact_digest" --arg archive "$archive_digest" --arg source_diff "$diff_digest" 'def p($s;$e):{passed:true,expected_state:$s,exit_class:$e};{schema:"capability-workshop-acceptance-evidence-v1",authority:"provisional",issue:51,candidate:$sha,artifact:$artifact,run_id:$run,checkout:{tree:$tree,supervisor_blob:$supervisor,helper_closure_sha256:$closure,executable_sha256:$executable,archive_sha256:$archive,source_diff_sha256:$source_diff},platform:{architecture:"arm64",filesystem:"apfs",runtime_contract:2},controls:{credential_by_path:true,deterministic_tests:true,deterministic_workshop:true,fresh_tasks:true,optional_bytes_preserved:true,redacted_complete_diff:true,source_confirmation_separate:true},scenarios:{create_without_activation:p("ready-no-projection";"success"),navigation_and_signals:p("q-eof-int-term-no-write";"success"),validate_and_test:p("ready";"success"),install:p("installed-healthy";"success"),explicit_invocation:p("declared-behavior-observed";"success"),enhancement_and_upgrade:p("source-changed-opaque-preserved-upgraded";"success"),source_workshop_interruption_recovery:p("journal-stopped-reentered-quiescent";"success"),collision_and_drift:p("foreign-and-owned-bytes-preserved";"refused"),disable_enable_remove:p("fresh-task-absent-source-preserved-control-reversed";"success"),lifecycle_interruption_recovery:p("projection-stopped-reaped-recovered";"success"),migration_and_rollback:p("private-copy-bounded";"success"),ambient_preservation:p("all-protected-equal";"success")},preservation:{ambient_home_equal:true,credential_source_equal:true,global_codex_equal:true,protected_canaries_equal:true,sibling_instance_equal:true,source_preserved:true},cleanup_expected:["credential-copy","instance","launcher","mount","run-root","volume-image"],redacted:true}')"
pbody="<!-- capability-workshop-acceptance-evidence-v1 authority=provisional -->
$provisional";purl="$(gh api -X POST "repos/$repo/issues/51/comments" -f body="$pbody" --jq .url)";pid="${purl##*/}";pdigest="$(printf %s "$pbody"|shasum -a 256|awk '{print $1}')"
expected=(.my-friday-acceptance:marker.json .my-friday-acceptance:workshop.sparseimage .my-friday-acceptance:mount .my-friday-acceptance:artifact .my-friday-acceptance:artifact/my-friday .my-friday-acceptance:artifact/my-friday-darwin-arm64.tar.gz .my-friday-acceptance:artifact/SHA256SUMS .my-friday-acceptance:acceptance-support .my-friday-acceptance:acceptance-runner .my-friday-acceptance:capability-stop-barrier .my-friday-acceptance:source-workshop-stop-barrier .my-friday-acceptance:launcher-capture.exp .my-friday-acceptance-evidence:marker.json .my-friday-acceptance-evidence:workshop-create.private .my-friday-acceptance-evidence:workshop-update.private .my-friday-acceptance-evidence:workshop-interrupted.private .my-friday-acceptance-evidence:source.diff.private .my-friday-acceptance-evidence:invocation.private .my-friday-acceptance-evidence:disabled.private);args=();for entry in "${expected[@]}";do args+=(--expected-entry "$entry");done;"$run_root/acceptance-support" cleanup-roots --home "$real_home" --run-id "$run_id" --receipt "$root_ids" --marker-sha256 "$marker_sha" "${args[@]}"
final="$(jq -nc --arg sha "$head_sha" --arg artifact "$authority" --argjson id "$pid" --arg digest "$pdigest" --arg closure "$helper_closure" '{schema:"capability-workshop-acceptance-evidence-v1",authority:"final",issue:51,candidate:$sha,artifact:$artifact,provisional:{id:$id,digest:$digest},helper_closure_sha256:$closure,cleanup:{ambient_unchanged:true,credential_copy_deleted:true,instance_removed:true,launcher_removed:true,mount_absent:true,non_forced_detach:true,run_root_deleted:true,source_preserved:true,volume_image_deleted:true}}')";fbody="<!-- capability-workshop-acceptance-evidence-v1 authority=final -->
$final";furl="$(gh api -X POST "repos/$repo/issues/51/comments" -f body="$fbody" --jq .url)";fid="${furl##*/}";fdigest="$(printf %s "$fbody"|shasum -a 256|awk '{print $1}')";token="capability-workshop-evidence-v1:provisional=$pid:$pdigest:final=$fid:$fdigest";actor="$(gh api user --jq .login)";GITHUB_REPOSITORY="$repo" "$root/bin/verify-capability-workshop-evidence" "$token" 51 "$head_sha" "$authority" "$actor">/dev/null;trap - EXIT INT TERM;printf '%s\n' "$token"
