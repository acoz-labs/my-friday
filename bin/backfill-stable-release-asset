#!/usr/bin/env bash
set -euo pipefail

tag="${1:-}"
source_name="${2:-}"
expected_executable="${3:-}"
repo="${GITHUB_REPOSITORY:-}"
stable_name="my-friday-darwin-arm64.tar.gz"
if [[ -z "$repo" || -z "$tag" || -z "$source_name" || "$source_name" == "$stable_name" || ! "$expected_executable" =~ ^[0-9a-f]{64}$ ]]; then
  echo "Usage: GITHUB_REPOSITORY=OWNER/REPO bin/backfill-stable-release-asset <latest-tag> <source-archive> <executable-sha256>" >&2
  exit 64
fi
release="$(gh release view "$tag" --repo "$repo" --json tagName,isDraft,isPrerelease,body,assets)"
latest="$(gh release view --repo "$repo" --json tagName --jq .tagName)"
if [[ "$(jq -r .tagName <<< "$release")" != "$latest" || "$(jq -r .isDraft <<< "$release")" != false || "$(jq -r .isPrerelease <<< "$release")" != false ]]; then
  echo "Backfill target must be the current published latest release." >&2
  exit 1
fi
ledger_body="$(jq -r '.body // ""' <<< "$release")"
ledger_count="$(printf '%s\n' "$ledger_body" | grep -c '^- Artifact:' || true)"
ledger_digest="$(printf '%s\n' "$ledger_body" | sed -n 's/^- Artifact: `sha256:\([0-9a-f]\{64\}\)`$/\1/p')"
if [[ "$ledger_count" != 1 || "$ledger_digest" != "$expected_executable" ]]; then
  echo "Release ledger must contain one accepted executable digest matching the requested backfill." >&2
  exit 1
fi
for name in "$source_name" SHA256SUMS; do
  [[ "$(jq --arg name "$name" '[.assets[] | select(.name == $name)] | length' <<< "$release")" == 1 ]] || { echo "Missing or ambiguous source asset: $name" >&2; exit 1; }
done
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
gh release download "$tag" --repo "$repo" --pattern "$source_name" --pattern SHA256SUMS --dir "$work"
source_digest="$(sha256sum "$work/$source_name" | awk '{print $1}')"
checksum_count="$(awk -v name="$source_name" '$2 == name { count++ } END { print count+0 }' "$work/SHA256SUMS")"
checksum_digest="$(awk -v name="$source_name" '$2 == name { print $1 }' "$work/SHA256SUMS")"
[[ "$checksum_count" == 1 && "$checksum_digest" == "$source_digest" ]] || { echo "Source archive checksum mismatch or ambiguity." >&2; exit 1; }
listing="$(tar -tvzf "$work/$source_name")"
entry_count=0
executable_entry=""
appledouble_entry=""
while IFS= read -r listing_line; do
  [[ -n "$listing_line" ]] || continue
  entry_count=$((entry_count + 1))
  entry_type="${listing_line:0:1}"
  entry_name="${listing_line##* }"
  entry_name="${entry_name#./}"
  if [[ "$entry_type" != "-" ]]; then
    echo "Source archive entries must be regular files." >&2
    exit 1
  elif [[ "$entry_name" == my-friday || "$entry_name" =~ ^my-friday-darwin-arm64-[0-9a-f]+$ ]]; then
    [[ -z "$executable_entry" ]] || { echo "Source archive contains ambiguous executables." >&2; exit 1; }
    executable_entry="$entry_name"
  elif [[ "$entry_name" =~ ^\._(my-friday|my-friday-darwin-arm64-[0-9a-f]+)$ ]]; then
    [[ -z "$appledouble_entry" ]] || { echo "Source archive contains ambiguous AppleDouble metadata." >&2; exit 1; }
    appledouble_entry="$entry_name"
  else
    echo "Source archive contains an unsupported entry." >&2
    exit 1
  fi
done <<< "$listing"
if [[ -z "$executable_entry" || "$entry_count" -gt 2 ||
  (-n "$appledouble_entry" && "$appledouble_entry" != "._$executable_entry") ]]; then
  echo "Source archive must contain one supported executable and only its optional AppleDouble companion." >&2
  exit 1
fi
tar -xzf "$work/$source_name" -C "$work" --no-same-owner -- "$executable_entry"
executable_path="$work/$executable_entry"
[[ -f "$executable_path" && ! -L "$executable_path" && -x "$executable_path" ]] || { echo "Unsafe source archive content." >&2; exit 1; }
[[ "$(sha256sum "$executable_path" | awk '{print $1}')" == "$expected_executable" ]] || { echo "Contained executable digest mismatch." >&2; exit 1; }
cp "$work/$source_name" "$work/$stable_name"
bin/release-assets "$tag" "$work/$stable_name"
echo "Verified stable alias $stable_name from $source_name on $tag."
