#!/usr/bin/env bash
set -euo pipefail

token="${1:-}"
issue="${2:-}"
sha="${3:-}"
artifact="${4:-}"
expected_actor="${5:-}"
repo="${GITHUB_REPOSITORY:-}"
allowed_actors="${PRODUCT_OWNER_ACTORS:-}"

die() { echo "$*" >&2; exit 1; }
digest_body() { printf %s "$1" | shasum -a 256 | awk '{print $1}'; }
normalize_actor() { printf %s "$1" | tr '[:upper:]' '[:lower:]'; }
actor_pattern='^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$'
malformed_allowlist='(^,)|(,$)|(,,)'

[[ -n "$repo" && "$issue" == 51 && "$sha" =~ ^[0-9a-f]{40}$ &&
  "$artifact" =~ ^artifact-v1:run=[0-9]+:id=[0-9]+:name=[A-Za-z0-9._-]+:sha256=[0-9a-f]{64}$ &&
  "$token" =~ ^capability-workshop-owner-receipt-v1:comment=([0-9]+):([0-9a-f]{64})$ ]] || exit 64
id="${BASH_REMATCH[1]}"
digest="${BASH_REMATCH[2]}"

[[ -n "${allowed_actors//[[:space:]]/}" && ! "$allowed_actors" =~ $malformed_allowlist ]] ||
  die "PRODUCT_OWNER_ACTORS must name the repository's authorized product owners."
normalized_allowlist=()
IFS=',' read -r -a actors <<< "$allowed_actors"
for raw_allowed in "${actors[@]}"; do
  allowed="$(printf '%s' "$raw_allowed" | xargs)"
  [[ "$allowed" =~ $actor_pattern ]] || die "PRODUCT_OWNER_ACTORS contains an invalid GitHub actor."
  normalized_allowlist+=("$(normalize_actor "$allowed")")
done

first="$(gh api "repos/$repo/issues/comments/$id")" || die "Workshop owner receipt comment is unavailable."
second="$(gh api "repos/$repo/issues/comments/$id")" || die "Workshop owner receipt disappeared during verification."
first_stable="$(jq -c '{id,body,issue_url,user:.user.login,created_at}' <<<"$first")"
second_stable="$(jq -c '{id,body,issue_url,user:.user.login,created_at}' <<<"$second")"
[[ "$first_stable" == "$second_stable" ]] ||
  die "Workshop owner receipt changed during verification."
[[ "$(jq -r .id <<<"$second")" == "$id" ]] || die "Workshop owner receipt ID mismatch."

body="$(jq -r .body <<<"$second")"
[[ "$(digest_body "$body")" == "$digest" ]] || die "Workshop owner receipt digest mismatch."
marker='<!-- capability-workshop-owner-receipt-v1 -->'
[[ "$body" == "$marker"$'\n'* && "${body#"$marker"$'\n'}" != *$'\n'* ]] ||
  die "Workshop owner receipt format mismatch."
json="${body#"$marker"$'\n'}"
actor="$(jq -r '.user.login | ascii_downcase' <<<"$second")"
[[ "$actor" =~ $actor_pattern ]] || die "Workshop owner receipt author is invalid."
actor_allowed=0
for allowed in "${normalized_allowlist[@]}"; do
  if [[ "$actor" == "$allowed" ]]; then actor_allowed=1; break; fi
done
[[ "$actor_allowed" == 1 ]] || die "Workshop owner receipt author is not listed in PRODUCT_OWNER_ACTORS."
[[ -z "$expected_actor" || "$actor" == "$(normalize_actor "$expected_actor")" ]] ||
  die "Workshop owner receipt author mismatch."
[[ "$(jq -r .issue_url <<<"$second")" == "https://api.github.com/repos/$repo/issues/$issue" ]] ||
  die "Workshop owner receipt belongs to another issue."

if ! retention="$(jq -er '.retention_decision | select(. == "retain" or . == "remove")' <<<"$json")"; then
  die "Workshop owner receipt is incomplete."
fi
expected_json="$(jq -nc \
  --argjson issue "$issue" \
  --arg sha "$sha" \
  --arg artifact "$artifact" \
  --arg retention "$retention" \
  '{schema:"capability-workshop-owner-receipt-v1",issue:$issue,candidate:$sha,artifact:$artifact,role:"product-owner",completion:true,source_comprehension:true,projection_comprehension:true,recovery_needed:false,retention_decision:$retention,acceptance_scope:"owner-operated-dogfood",migration_evidence_issue:92,migration_evidence_due:"before-release",independent_user_validation:"not-collected",redacted:true}')"
[[ "$json" == "$expected_json" ]] || die "Workshop owner receipt is incomplete."

printf '%s\n' "$actor"
