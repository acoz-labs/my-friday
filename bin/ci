#!/usr/bin/env bash
set -euo pipefail

bin/validate-solution-plans
bin/test-release-assets
bin/test-acceptance-evidence
bin/test-capability-workshop-evidence
bin/test-acceptance-contract
bin/test-acceptance-primitives

unformatted="$(gofmt -l cmd internal tools)"
if [[ -n "$unformatted" ]]; then
  echo "Go files require gofmt:" >&2
  echo "$unformatted" >&2
  exit 1
fi

go vet ./...
go test -race ./...
GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 go build -o /dev/null ./cmd/my-friday
GOOS=darwin GOARCH=arm64 CGO_ENABLED=0 go build -o /dev/null ./tools/acceptance-support
GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -o /dev/null ./tools/acceptance-support

echo "bin/ci completed."
