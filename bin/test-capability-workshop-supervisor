#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

bin/test-capability-workshop-abandon-driver
go test ./cmd/my-friday -run 'TestRealWorkshopSignalsInterruptPromptWithoutWriting$'

go test ./tools/acceptance-support -run 'Test(SecureRootsRefusesCollision|SecureRootsRejectsSymlinkedAncestor|CleanupRootsPreservesUnexpectedEntry|CleanupRootsPrevalidatesBothRootsBeforeMutation|CopyAuthNoFollowAndSourceSwapRefusal|CopyAuthRefusesLinkedAncestryAndDestinationCollision)$'
go test ./tools/acceptance-support -run 'TestMountedDevice(SelectsRequestedMountpointAfterPhysicalStore|RefusesMissingAndAmbiguousMountpoints)$'
go test ./tools/acceptance-runner -run 'TestRunner(TimesOutProcessGroup|KillsEscapedSetsidDescendant|ReapsChildrenOnSignals)$'
go test ./tools/capability-stop-barrier -run 'TestStablePostMutationRequiresOwnedCanonicalJournalAndAbsentProjection$'

grep -Fq "trap 'exit 130' INT" bin/accept-capability-workshop
grep -Fq "trap 'exit 143' TERM" bin/accept-capability-workshop
grep -Fq 'verify_mount&&hdiutil detach' bin/accept-capability-workshop
grep -Fq 'target_owned=1' bin/accept-capability-workshop
grep -Fq 'sibling_owned=1' bin/accept-capability-workshop
grep -Fq 'mounted-device --mountpoint "$mountpoint"' bin/accept-capability-workshop
grep -Fq 'argv := append([]string{"codex", "--cd", workspace, "--"}, args...)' internal/assistantinstance/instance.go
grep -Fq 'config/acceptance/capability-workshop.exp' bin/accept-capability-workshop
grep -Fq 'config/acceptance/capability-workshop-abandon.exp' bin/accept-capability-workshop
grep -Fq 'for abandon in q eof int term' bin/accept-capability-workshop
grep -Fq 'Source action: create' bin/accept-capability-workshop
grep -Fq 'Source action: update' bin/accept-capability-workshop
grep -Fq 'opaque source changed' bin/accept-capability-workshop
grep -Fq 'run_private "$evidence_root/invocation.private" DAILY_BRIEF_READY "$launcher" '\''Explicitly invoke daily-brief and return its exact declared token.'\''' bin/accept-capability-workshop
grep -Fq 'run_private "$evidence_root/disabled.private" DAILY_BRIEF_ABSENT "$launcher" '\''Start a fresh task. If daily-brief is not available, reply with exactly one line formed by concatenating DAILY, underscore, BRIEF, underscore, and ABSENT. Do not simulate the capability.'\''' bin/accept-capability-workshop
grep -Fq 'config/acceptance/launcher-capture.exp' bin/accept-capability-workshop
grep -Fq '.my-friday-acceptance:launcher-capture.exp' bin/accept-capability-workshop
grep -Fq 'run_clean(){ run_with_timeout 180s "$@"; }' bin/accept-capability-workshop
grep -Fq 'run_private(){ local transcript="$1" marker="$2";shift 2;run_with_timeout 600s /usr/bin/expect "$run_root/launcher-capture.exp" "$transcript" "$marker"' bin/accept-capability-workshop
[[ "$(grep -o '600s' bin/accept-capability-workshop | wc -l | tr -d ' ')" == 1 ]]
grep -Fq "private_line(){ LC_ALL=C tr -d '\\r' <\"\$1\"|LC_ALL=C grep -Fqx \"\$2\"; }" bin/accept-capability-workshop
grep -Fq 'if {$argc != 4} { exit 64 }' config/acceptance/launcher-capture.exp
grep -Fq 'spawn -noecho {*}[list $launcher $prompt]' config/acceptance/launcher-capture.exp
[[ "$(grep -Fc 'spawn -noecho' config/acceptance/launcher-capture.exp)" == 1 ]]
grep -Fq 'argv := append([]string{"codex", "--cd", workspace, "--"}, args...)' internal/assistantinstance/instance.go
grep -Fq 'if {[string first $marker $prompt] >= 0} { exit 65 }' config/acceptance/launcher-capture.exp

grep -Fq 'Type Create source to continue' config/acceptance/capability-workshop.exp
grep -Fq 'Type Update source to continue' config/acceptance/capability-workshop.exp
if grep -Eq 'builder_prompt|validate-builder-prompt-input|BUILDER_SOURCE_READY' bin/accept-capability-workshop; then
  echo "Model builder authority remains in deterministic workshop acceptance" >&2
  exit 1
fi
if grep -F 'run_private "$evidence_root/disabled.private"' bin/accept-capability-workshop | grep -Fq 'reply exactly DAILY_BRIEF_ABSENT'; then
  echo "Disabled prompt contains its completion marker" >&2
  exit 1
fi
if grep -Eq '\$launcher" (exec|--skip-git-repo-check)' bin/accept-capability-workshop; then
  echo "Capability workshop passed Codex CLI options through the named launcher" >&2
  exit 1
fi

echo "Capability workshop supervisor adversarial tests passed."
