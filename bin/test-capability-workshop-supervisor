#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

go test ./tools/acceptance-support -run 'Test(SecureRootsRefusesCollision|SecureRootsRejectsSymlinkedAncestor|CleanupRootsPreservesUnexpectedEntry|CleanupRootsPrevalidatesBothRootsBeforeMutation|CopyAuthNoFollowAndSourceSwapRefusal|CopyAuthRefusesLinkedAncestryAndDestinationCollision)$'
go test ./tools/acceptance-support -run 'TestMountedDevice(SelectsRequestedMountpointAfterPhysicalStore|RefusesMissingAndAmbiguousMountpoints)$'
go test ./tools/acceptance-runner -run 'TestRunner(TimesOutProcessGroup|KillsEscapedSetsidDescendant|ReapsChildrenOnSignals)$'
go test ./tools/capability-stop-barrier -run 'TestStablePostMutationRequiresOwnedCanonicalJournalAndAbsentProjection$'

grep -Fq "trap 'exit 130' INT" bin/accept-capability-workshop
grep -Fq "trap 'exit 143' TERM" bin/accept-capability-workshop
grep -Fq 'verify_mount&&hdiutil detach' bin/accept-capability-workshop
grep -Fq 'target_owned=1' bin/accept-capability-workshop
grep -Fq 'sibling_owned=1' bin/accept-capability-workshop
grep -Fq 'mounted-device --mountpoint "$mountpoint"' bin/accept-capability-workshop
grep -Fq 'argv := append([]string{"codex", "--cd", workspace, "--"}, args...)' internal/assistantinstance/instance.go
grep -Fq 'run_private "$evidence_root/builder.private" "$launcher" "$builder_prompt"' bin/accept-capability-workshop
grep -Fq 'run_private "$evidence_root/invocation.private" "$launcher" '\''Explicitly invoke daily-brief and return its exact declared token.'\''' bin/accept-capability-workshop
grep -Fq 'run_private "$evidence_root/disabled.private" "$launcher" '\''Start a fresh task. If daily-brief is not available, reply exactly DAILY_BRIEF_ABSENT. Do not simulate it.'\''' bin/accept-capability-workshop
grep -Fq 'config/acceptance/launcher-capture.exp' bin/accept-capability-workshop
grep -Fq '.my-friday-acceptance:launcher-capture.exp' bin/accept-capability-workshop
grep -Fq 'run_private(){ local transcript="$1";shift;run_clean /usr/bin/expect "$run_root/launcher-capture.exp"' bin/accept-capability-workshop
if grep -Eq '\$launcher" (exec|--skip-git-repo-check)' bin/accept-capability-workshop; then
  echo "Capability workshop passed Codex CLI options through the named launcher" >&2
  exit 1
fi

echo "Capability workshop supervisor adversarial tests passed."
