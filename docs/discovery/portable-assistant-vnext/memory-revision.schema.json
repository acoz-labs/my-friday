{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:my-friday:schemas:draft:memory-revision:1",
  "title": "Proposed portable memory revision",
  "description": "Design fixture. Graph, scope, immutable-write, and source-reference invariants also require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "record_id", "kind", "scope", "summary", "body",
    "recorded_at", "effective_from", "authorship", "evidence", "supersedes", "change_reason",
    "sensitivity", "volatility"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "record_id": { "$ref": "#/$defs/id" },
    "kind": {
      "enum": ["fact", "preference", "decision", "procedure", "project-state", "entity", "commitment", "research-claim"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["assistant", "project", "account", "task"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "sensitivity": { "enum": ["public", "private", "sensitive", "restricted"] },
    "volatility": { "enum": ["stable", "drift-prone", "live-state"] },
    "last_verified_at": { "type": ["string", "null"], "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "effective_from": { "type": "string", "format": "date-time" },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "actor", "harness", "model", "session_id"],
      "properties": {
        "device_id": { "$ref": "#/$defs/id" },
        "actor": { "type": "string", "minLength": 1 },
        "harness": { "type": ["string", "null"], "minLength": 1 },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "session_id": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "confidence", "source_refs"],
      "properties": {
        "basis": { "enum": ["user-direction", "observation", "inference", "import"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "change_reason": { "type": "string", "minLength": 1 },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$" },
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$" }
  }
}
